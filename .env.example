# Copy to .env and adjust. Every value here is also the default in smartup_rag/config.py — nothing needs a secret.

# ---- Ollama (local LLM and embeddings) ----------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
# Recommended: qwen3.5:9b (6.6 GB). Alternatives: gemma4:12b (7.6 GB), qwen3:8b
CHAT_MODEL=qwen3.5:9b
CHAT_TEMPERATURE=0.1
CHAT_NUM_CTX=16384
CHAT_THINK=false
# How long Ollama keeps the models loaded after the last question (an unload costs the next visitor ~30 s).
# -1 = until Ollama restarts. The embedding model gets the same keep-alive.
CHAT_KEEP_ALIVE=24h
# Optional smaller model for the scope/intent classifier (defaults to CHAT_MODEL)
# CLASSIFIER_MODEL=qwen3.5:4b

# ---- Local index: Chroma vectors + SQLite FTS5 BM25 (built by `smartup ingest`) --------
# The lecture documents the index is built from — the project's only data source
DATA_DIR=data/raw/drive_09_2026
# Where `smartup ingest` writes the index (git-ignored). Restart the API after re-ingesting.
INDEX_DIR=data/index
COLLECTION_NAME=smartup_passages
# Ollama embedding model (multilingual and cross-lingual). Changing it requires `smartup ingest --recreate`.
EMBED_MODEL=bge-m3

# ---- Local cross-encoder reranker (sentence-transformers, weights from the Hugging Face Hub) ----
RERANK_ENABLED=true
RERANK_MODEL=BAAI/bge-reranker-v2-m3
# auto = CUDA, else Apple MPS, else CPU
RERANK_DEVICE=auto

# ---- Retrieval tuning -------------------------------------------------------
TOP_K_PASSAGES=8
# Search both languages' passages for every question (bge-m3 is cross-lingual)
CROSS_LINGUAL=true
# Thresholds on the cross-encoder's score, calibrated for bge-reranker-v2-m3 (README §10).
# A different RERANK_MODEL needs its own calibration.
MIN_RERANK_SCORE=0.02
GRADE_STRONG_THRESHOLD=0.70
GRADE_WEAK_THRESHOLD=0.03

# ---- Ingestion ---------------------------------------------------------------
# Digital Innovation IDC lectures belong to the "other outside lectures" tier; false hides them
INCLUDE_DIGITAL_INNOVATION=true
PASSAGE_CHARS=1200
PASSAGE_OVERLAP=200

# ---- API --------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
# Comma-separated origins allowed to call the API from the browser (your website)
CORS_ORIGINS=*
MAX_HISTORY_TURNS=6
LOG_LEVEL=INFO
# Interactive API docs at /docs and /openapi.json — set false on a public host
API_DOCS_ENABLED=true
# Requests per minute per client IP across /chat and /chat/stream (0 = no limit)
CHAT_RATE_LIMIT_PER_MINUTE=12
# Larger request bodies are rejected before parsing
MAX_REQUEST_BYTES=65536
# Pipeline dashboard at /dashboard (every call's query, passages, prompt, timings):
# local = this machine only · on = everyone who can reach the API · off = no tracing
DEBUG_DASHBOARD=local

# Prime the model + system-prompt cache, and load the embedding model and the reranker, at API startup so the
# first visitor is not charged the cold start (set false on a machine where RAM is contended).
WARM_ON_STARTUP=true
# While no chat runs, re-prime that cache every N minutes and right after a question shows it was lost
# (e.g. Ollama reloaded the model). 0 disables it.
KEEP_WARM_MINUTES=10

# ---- Advanced knobs (defaults shown) ---------------------------------------------
# CHAT_TIMEOUT_S=240.0
# EMBED_BATCH_SIZE=32
# EMBED_TIMEOUT_S=120.0
# RERANK_MAX_LENGTH=512
# RERANK_BATCH_SIZE=16
# RANK_WINDOW=30
# RANK_CONSTANT=60
# Fallback chain: search TEDx / v1 / outside lectures in the background while v2 is graded, and reject a weak fallback
# source without an LLM call when a later source already has a strong match (0 = off)
# PREFETCH_FALLBACK=true
# SKIP_WEAK_GRADE_BELOW=0.04
# SKIP_WEAK_GRADE_BELOW_TEDX=0.09
# MAX_PASSAGE_CHARS=2500
# INSTRUCTIONS_PATH=instructions.md
